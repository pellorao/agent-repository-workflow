{"flow": "audit-round", "desc": "一轮 Commit Audit: 冻结候选 (屏障), 计轮次, 按冻结输入决定哪些轴要审, 两个 Reviewer 与完整验证并行, 汇总结果.", "entry": "freeze", "returns": {"all-clear": "两轴无问题且验证通过", "findings": "有问题或验证失败", "error": "冻结失败或 Reviewer 未完成"}}
{"id": "freeze", "type": "program", "desc": "暂存树 `git write-tree` 与 `base` 固定为本轮受审版本; 运行中的输入不改写.", "primitive": "commitAudit.prepare", "args": {}, "next": {"frozen": "round", "error": "return:error"}, "barrier": true, "src": ["skills/commit/implementation-workflow.md#3", "skills/commit/implementation-workflow.md#12", "skills/commit/implementation-workflow.md#13", "skills/reviewer-launch/SKILL.md#6", "skills/reviewer-launch/SKILL.md#10"]}
{"id": "round", "type": "program", "desc": "按同一授权范围数轮次, 第 3 轮起的处置规则由此生效.", "primitive": "round.next", "args": {"scope": "$state.authorizingIssueIds"}, "next": {"counted": "axes"}, "src": ["skills/commit/fix-rounds.md#2"]}
