        "distribution/skills/prototype/LOGIC.md",
        "distribution/skills/prototype/UI.md"
      ]
    },
    "skills-english": {
      "language": "english",
      "minPercentage": 100,
      "include": [
        ".agents/skills/codebase-design/**/*.md",
        ".agents/skills/diagnosing-bugs/**/*.md",
